{
	"name": "@techstream/quark-root",
	"private": true,
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"build": "turbo run build",
		"dev": "dotenv -- turbo run dev",
		"lint": "biome format --write && biome check --write",
		"lint:unsafe": "biome format --write && biome check --write --unsafe",
		"lint:all": "turbo run lint",
		"test": "turbo run test",
		"test:integration": "pnpm --filter @techstream/quark-web test:integration",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"docker:list": "docker compose ps",
		"docker:restart": "docker compose restart",
		"docker:clean": "docker compose down -v",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:push": "turbo run db:push",
		"db:seed": "turbo run db:seed",
		"format": "biome format --write",
		"new": "node packages/cli/src/index.js",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "changeset publish",
		"prepare": "simple-git-hooks"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.12.1",
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"nodemailer": "*"
			}
		},
		"overrides": {
			"lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
			"hono@<4.11.7": ">=4.11.7"
		}
	},
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@changesets/changelog-github": "^0.5.2",
		"@changesets/cli": "^2.29.8",
		"@types/node": "^25.3.0",
		"baseline-browser-mapping": "^2.10.0",
		"dotenv-cli": "^11.0.0",
		"nano-staged": "^0.9.0",
		"prisma": "^7.4.1",
		"simple-git-hooks": "^2.13.1",
		"tsx": "^4.21.0",
		"turbo": "^2.8.10"
	},
	"simple-git-hooks": {
		"pre-commit": "node packages/cli/scripts/sync-templates.js --pre-commit && pnpm nano-staged",
		"pre-push": "pnpm test"
	},
	"nano-staged": {
		"packages/cli/templates/**": [],
		"{apps,packages,docs,scripts}/**/*.{js,mjs,ts,tsx,json,css}": [
			"biome format --write",
			"biome check --write"
		]
	},
	"dependencies": {
		"@prisma/client": "^7.4.0"
	}
}
