{
	"name": "@techstream/quark-root",
	"private": true,
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"clean": "node scripts/clean-workspace.mjs",
		"clean:check": "node scripts/clean-workspace.mjs --check",
		"clean:deep": "node scripts/clean-workspace.mjs --deep",
		"build": "dotenv -- turbo run build",
		"dev": "dotenv -- tsx scripts/dev-preflight.mjs && dotenv -- turbo run dev",
		"dev:sync": "node packages/cli/scripts/sync-watch.js",
		"dev:mobile": "pnpm --filter @techstream/quark-mobile start",
		"build:mobile": "pnpm --filter @techstream/quark-mobile export",
		"lint": "biome format --write && biome check --write",
		"lint:unsafe": "biome format --write && biome check --write --unsafe",
		"lint:all": "turbo run lint",
		"standards": "node scripts/check-standards.mjs",
		"smoke:published": "node packages/cli/scripts/smoke-published.js",
		"test": "turbo run test",
		"test:integration": "pnpm --filter @techstream/quark-web test:integration",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"docker:list": "docker compose ps",
		"docker:restart": "docker compose restart",
		"docker:clean": "docker compose down -v",
		"db:generate": "turbo run db:generate",
		"db:migrate": "pnpm --filter ./packages/db db:migrate",
		"db:migrate:deploy": "pnpm --filter ./packages/db db:migrate:deploy",
		"db:push": "turbo run db:push",
		"db:seed": "turbo run db:seed",
		"format": "biome format --write",
		"new": "node packages/cli/src/index.js",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "changeset publish",
		"prepare": "node scripts/prepare.mjs"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.12.1",
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@changesets/changelog-github": "^0.6.0",
		"@changesets/cli": "^2.30.0",
		"@types/node": "^25.5.0",
		"baseline-browser-mapping": "^2.10.8",
		"dotenv-cli": "^11.0.0",
		"nano-staged": "^0.9.0",
		"prisma": "^7.8.0",
		"simple-git-hooks": "^2.13.1",
		"tsx": "^4.21.0",
		"turbo": "^2.10.12"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm nano-staged && node packages/cli/scripts/sync-templates.js --pre-commit",
		"pre-push": "node scripts/pre-push.mjs"
	},
	"nano-staged": {
		"packages/cli/templates/**": [],
		"{apps,packages,docs,scripts}/**/*.{js,jsx,mjs,json,css}": [
			"biome format --no-errors-on-unmatched --write",
			"biome check --no-errors-on-unmatched --write"
		]
	},
	"dependencies": {
		"@prisma/client": "^7.10.0"
	}
}
