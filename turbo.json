{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build", "db:generate"],
			"outputs": ["dist/**", ".next/**"],
			"env": ["NODE_ENV"]
		},
		"lint": {
			"outputs": []
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": []
		},
		"db:generate": {
			"cache": false,
			"outputs": ["node_modules/.prisma/client"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
