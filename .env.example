# --- Database Configuration ---
# These map to the service names in docker-compose.yml
POSTGRES_USER=techstream_user
POSTGRES_PASSWORD=techstream_password
POSTGRES_DB=techstream_dev
DATABASE_URL="postgresql://techstream_user:techstream_password@localhost:5432/techstream_dev?schema=public"

# --- Redis Configuration ---
REDIS_URL="redis://localhost:6379"

# --- Worker Configuration ---
NEXTAUTH_SECRET=your_very_long_secure_secret_here
MAILHOG_SMTP_URL=smtp://localhost:1025

# --- Web App Configuration ---
WEB_PORT=3000
