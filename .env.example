# --- Database Configuration ---
# These map to the service names in docker-compose.yml
POSTGRES_USER=quark_user
POSTGRES_PASSWORD=quark_password
POSTGRES_DB=quark_dev
DATABASE_URL="postgresql://quark_user:quark_password@localhost:5432/quark_dev?schema=public"

# --- Redis Configuration ---
REDIS_URL="redis://localhost:6379"

# --- Worker Configuration ---
NEXTAUTH_SECRET=your_very_long_secure_secret_here
MAILHOG_SMTP_URL=smtp://localhost:1025

# --- Web App Configuration ---
WEB_PORT=3000
