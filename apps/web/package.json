{
	"name": "@techstream/quark-web",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"clean": "rm -rf .next",
		"dev": "next dev",
		"build": "next build",
		"prepare:standalone": "node ./scripts/prepare-standalone.mjs",
		"build:deploy": "pnpm build && pnpm prepare:standalone",
		"start": "next start",
		"start:deploy": "node .next/standalone/apps/web/server.js",
		"test": "node ../../scripts/run-tests.mjs src --exclude=integration.test.js",
		"test:integration": "node --test src/app/api/integration.test.js",
		"lint": "biome format --write && biome check --write"
	},
	"dependencies": {
		"@auth/prisma-adapter": "^2.11.2",
		"@prisma/client": "^7.8.0",
		"@techstream/quark-admin": "workspace:*",
		"@techstream/quark-cms": "workspace:*",
		"@techstream/quark-config": "workspace:*",
		"@techstream/quark-core": "workspace:*",
		"@techstream/quark-crm": "workspace:*",
		"@techstream/quark-db": "workspace:*",
		"@techstream/quark-jobs": "workspace:*",
		"@techstream/quark-ui": "workspace:*",
		"lucide-react": "^1.18.0",
		"next": "16.2.9",
		"next-auth": "5.0.0-beta.31",
		"pg": "^8.21.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"rrweb": "2.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.2.1",
		"@types/node": "^25.3.5",
		"tailwindcss": "^4.2.1"
	}
}
