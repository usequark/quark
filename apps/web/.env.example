# --- Database Configuration ---
# Defaults match docker-compose.yml - change for production
POSTGRES_HOST=localhost
POSTGRES_PORT=5430
POSTGRES_USER=quark_user
POSTGRES_PASSWORD=quark_password
POSTGRES_DB=quark_dev

# --- Redis Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6385

# --- Mail Configuration (Mailpit in development) ---
MAIL_HOST=localhost
MAIL_SMTP_PORT=1030
MAIL_UI_PORT=8030

# --- Email Provider ---
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=YourApp <noreply@yourdomain.com>

# --- NextAuth Configuration ---
# REQUIRED: must match the exact URL the web app runs on (no trailing slash)
NEXTAUTH_URL=http://localhost:3005
# Generate a secret: node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace_with_a_long_random_secret

# --- OAuth Providers (optional) ---
# Leave every variable in this section unset and social sign-in is off.
# Nothing in Quark requires these.
#
# Each provider is enabled by its client id alone. These are the credentials
# the /api/auth/google and /api/auth/apple routes bind tokens to — with no
# client id, the matching route refuses every request with 503 rather than
# exchanging a token it cannot bind to this deployment.
#
# GitHub - Get credentials at: https://github.com/settings/developers
# GITHUB_ID=your_github_client_id
# GITHUB_SECRET=your_github_client_secret

# Google - Get credentials at: https://console.cloud.google.com/apis/credentials
# Both halves together add the Google button to the web sign-in page.
# The client id is also the token audience POST /api/auth/google checks on
# every sign-in, so a mismatch with the mobile app fails the login.
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple - Create a Services ID at: https://developer.apple.com/account/resources/identifiers/list/serviceId
# The Services ID is the token audience POST /api/auth/apple checks on every
# sign-in. No secret is involved - that route verifies the signed identity
# token itself.
# APPLE_CLIENT_ID=com.example.yourapp

# --- SEO / Indexing ---
# Set to "true" ONLY in your production deployment.
# Staging and preview environments should leave this unset so they are not indexed.
# ALLOW_INDEXING=true

# --- Optional: Umami Analytics ---
# Leave all three unset to disable analytics cleanly.
# Set URL + website ID to load Umami script.js in the root layout head.
# Replay stays off unless NEXT_PUBLIC_UMAMI_REPLAY_ENABLED=true.
# Umami Links and Pixels are dashboard-generated URLs, so the scaffold does not add extra env vars for them.
# Use tracked links in campaigns/emails and pixel URLs only in HTML emails or external pages.
# NEXT_PUBLIC_UMAMI_URL=https://stats.example.com
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# NEXT_PUBLIC_UMAMI_REPLAY_ENABLED=false

# --- Web App Configuration ---
PORT=3005
# REQUIRED for container deployments (Docker/Railway/Vercel standalone):
# HOSTNAME=0.0.0.0

# --- Booking Slots ---
# PER_SERVICE (default): each service has its own slot inventory.
# SHARED: all services share the same slot inventory.
# BOOKING_SLOT_SCOPE=PER_SERVICE

# --- Authentication ---
# Toggle this during development to enable or disable public self-service signup.
AUTH_ALLOW_SIGNUP=true

# --- Worker Configuration ---
WORKER_CONCURRENCY=5

# --- Admin Seed ---
# Used only by `pnpm db:seed` to create the initial admin user.
# ADMIN_PASSWORD is required - there is no default. Generate one:
#   openssl rand -base64 24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SET_ME
# ADMIN_NAME=Admin

# --- Metrics Scraping ---
# Set to a long random secret to protect /api/metrics from public access.
# Prometheus scrapers should pass: Authorization: Bearer <token>
# Leave unset in development - the endpoint is unprotected by default.
# METRICS_TOKEN=replace_with_a_long_random_secret

# --- File Storage ---
# Default: local filesystem (./uploads). No further config needed for development.
STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=./uploads

# --- Optional: S3-Compatible Storage (AWS S3, Cloudflare R2, MinIO) ---
# Only configure when STORAGE_PROVIDER=s3. Not required for local development.
# Install @aws-sdk/client-s3 and @aws-sdk/s3-request-presigner in the app when enabling S3-compatible storage.
# S3_BUCKET=my-bucket
# S3_REGION=auto
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-xxx.r2.dev

# --- Optional: CDN ---
# Provider-agnostic CDN base URL for serving assets (CloudFront, Cloudflare, Bunny, etc.).
# Falls back to /api/files when unset - works fine without a CDN.
# ASSET_CDN_URL=https://assets.example.com
