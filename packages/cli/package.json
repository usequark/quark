{
	"name": "@usequark/quark-create-app",
	"version": "1.25.4",
	"description": "CLI to scaffold new Quark projects with Next.js, Prisma, BullMQ, and Railway deployment",
	"keywords": [
		"quark",
		"scaffolding",
		"scaffolder",
		"cli",
		"nextjs",
		"prisma",
		"bullmq",
		"railway",
		"self-hosted"
	],
	"type": "module",
	"homepage": "https://github.com/usequark/quark#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/usequark/quark.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/usequark/quark/issues"
	},
	"author": "Quark Contributors",
	"bin": {
		"quark": "src/index.js",
		"quark-create-app": "src/index.js",
		"create-quark-app": "src/index.js",
		"quark-update": "src/index.js"
	},
	"files": [
		"src",
		"!src/**/*.test.js",
		"templates",
		"README.md"
	],
	"devDependencies": {
		"esbuild": "^0.28.2"
	},
	"scripts": {
		"sync-templates": "node scripts/sync-templates.js",
		"sync-templates:check": "node scripts/sync-templates.js --check",
		"regen-migration": "node scripts/regenerate-template-migration.js",
		"smoke:published": "node scripts/smoke-published.js",
		"test": "node test-cli.js && node --test src/utils.test.js && node --test src/prepare-hooks.test.js && node --test src/scaffold-output.test.js && node --test src/template-scripts.test.js && node --test src/scaffold-guards.test.js && node --test src/template-config.test.js && node --test src/worker-dockerfile.test.js && node --test src/dependabot-config.test.js && node --test 'src/deploy/**/*.test.js' && node --test --test-concurrency=1 'src/deploy/**/*.integration.test.js'",
		"test:build": "node test-build.js",
		"test:e2e": "node test-e2e.js",
		"test:e2e:full": "node test-e2e-full.js",
		"test:integration": "node test-integration.js",
		"test:flags": "node --test test-flags.js",
		"test:all": "node test-all.js",
		"check:perf": "node scripts/check-e2e-perf.js"
	},
	"dependencies": {
		"chalk": "^6.0.0",
		"commander": "^15.0.0",
		"execa": "^10.0.1",
		"fs-extra": "^11.4.1",
		"prompts": "^2.4.2"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"license": "MIT"
}
