# --- Database Configuration ---
# Defaults match docker-compose.yml — change for production
POSTGRES_HOST=localhost
POSTGRES_PORT=5430
POSTGRES_USER=quark_user
POSTGRES_PASSWORD=quark_password
POSTGRES_DB=quark_dev

# --- Redis Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6385

# --- Mail Configuration (Mailpit in development) ---
MAIL_HOST=localhost
MAIL_SMTP_PORT=1030
MAIL_UI_PORT=8030

# --- Email Provider ---
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=YourApp <noreply@yourdomain.com>

# --- NextAuth Configuration ---
# REQUIRED: must match the exact URL the web app runs on (no trailing slash)
NEXTAUTH_URL=http://localhost:3005
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace_with_a_long_random_secret

# --- OAuth Providers (optional) ---
# Uncomment and fill in to enable GitHub / Google sign-in
# GITHUB_ID=your_github_oauth_app_client_id
# GITHUB_SECRET=your_github_oauth_app_client_secret
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# --- SEO / Indexing ---
# Set to "true" ONLY in your production deployment.
# Staging and preview environments should leave this unset so they are not indexed.
# ALLOW_INDEXING=true

# --- Web App Configuration ---
PORT=3005

# --- Worker Configuration ---
WORKER_CONCURRENCY=5

# --- File Storage ---
STORAGE_PROVIDER=local
