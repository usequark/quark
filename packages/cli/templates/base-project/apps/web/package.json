{
	"name": "@myquark/web",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"clean": "rm -rf .next",
		"dev": "next dev",
		"build": "next build",
		"prepare:standalone": "node ./scripts/prepare-standalone.mjs",
		"build:deploy": "pnpm build && pnpm prepare:standalone",
		"start": "next start",
		"start:deploy": "node .next/standalone/apps/web/server.js",
		"test": "node ../../scripts/run-tests.mjs src --exclude=integration.test.js",
		"lint": "biome format --write && biome check --write"
	},
	"dependencies": {
		"@auth/prisma-adapter": "^2.11.1",
		"@aws-sdk/client-s3": "^3.1004.0",
		"@aws-sdk/s3-request-presigner": "^3.1004.0",
		"@prisma/client": "^7.8.0",
		"@techstream/quark-core": "^2.0.0",
		"@techstream/quark-db": "workspace:*",
		"@techstream/quark-jobs": "workspace:*",
		"@techstream/quark-ui": "workspace:*",
		"ioredis": "^6.0.0",
		"jose": "^6.0.11",
		"next": "16.1.6",
		"next-auth": "5.0.0-beta.31",
		"pg": "^8.20.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"rrweb": "2.0.0-alpha.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.6.2",
		"tailwindcss": "^4.3.3",
		"@techstream/quark-config": "workspace:*"
	}
}
