## Import Reference

```javascript
// ✅ Workspace packages - always @__QUARK_SCOPE__/*:
import { prisma, user, post }    from "@__QUARK_SCOPE__/db";
import { loadConfig }            from "@__QUARK_SCOPE__/config";
import { Button, Card, Input }   from "@__QUARK_SCOPE__/ui";
import { JOB_TYPES }             from "@__QUARK_SCOPE__/jobs";

// ✅ Published runtime - @usequark/quark-core:
import { AppError, ValidationError, NotFoundError } from "@usequark/quark-core/errors";
import { createLogger, getCurrentSession }          from "@usequark/quark-core";
import { createQueue, addJob }                      from "@usequark/quark-core";
import { metrics, cache, storage }                  from "@usequark/quark-core";

// ❌ Never:
import { Button } from "@/components/ui/button";     // wrong path convention
import { prisma } from "@usequark/quark-db";        // wrong scope for workspace pkg
import something  from "@usequark/quark-config";    // wrong scope for workspace pkg
```

