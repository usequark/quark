# Default Railway runtime variables for __QUARK_PROJECT_NAME__.
# Copy these values into Railway shared/service variables as a starting point.
# Railway does not read docker-compose.yml or the local .env example.
# Add managed PostgreSQL and Redis services in Railway first, then wire the
# placeholders below with Railway service references or pasted connection
# strings before the first deploy.
# Railway injects PORT automatically, so do not set it manually here.

# --- Core runtime ---
NODE_ENV=production
# Forces the standalone Next.js server to bind on Railway's network interface.
HOSTNAME=0.0.0.0
APP_NAME=__QUARK_PROJECT_NAME__
APP_DESCRIPTION=Update this before production deployment.
# APP_URL must be an absolute public URL with https://
APP_URL=https://__QUARK_PROJECT_NAME__.railway.app
ALLOW_INDEXING=false
AUTH_ALLOW_SIGNUP=false

# --- Auth ---
# Generate with: openssl rand -base64 32
# AUTH_SECRET is an alternative name; the deploy CLI auto-sets both.
# Must be at least 32 characters or startup validation fails.
NEXTAUTH_SECRET=CHANGE_ME_TO_A_32_CHARACTERS_OR_LONGER_SECRET

# --- Optional OAuth providers ---
# Unset by default; social sign-in stays off. These are the credentials the
# /api/auth/google and /api/auth/apple routes bind tokens to — with no client
# id, the matching route refuses every request with 503. Server-only: do not
# prefix them with NEXT_PUBLIC_.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# GITHUB_ID=
# GITHUB_SECRET=

# APP_URL is the canonical public URL. NEXTAUTH_URL is derived automatically.
# Uncomment only if you need to override it explicitly.
# NEXTAUTH_URL=https://__QUARK_PROJECT_NAME__.railway.app

# --- Managed infrastructure ---
# `quark deploy railway` automatically sets DATABASE_URL and REDIS_URL using
# Railway service references (${{Postgres.DATABASE_URL}}, ${{Redis.REDIS_URL}}).
# You only need to set these manually if you are not using the CLI deploy flow.
# DATABASE_URL=postgresql://user:pass@host:5432/db
# REDIS_URL=redis://user:pass@host:6379

# --- Worker ---
WORKER_CONCURRENCY=5

# --- Optional remote seed defaults ---
# Used only when you intentionally run `pnpm db:seed` against Railway.
# Remove these after the first seed if you do not want bootstrap admin
# credentials stored in Railway long term.
SEED_PROFILE=minimal
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_ADMIN_PASSWORD
# ADMIN_NAME=Admin

# --- Storage ---
# Local storage is ephemeral on Railway. Keep this only if uploaded files do not
# need to survive redeploys or reschedules. For durable uploads, switch to s3.
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=s3
# S3_BUCKET=your-bucket-name
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_PUBLIC_URL=https://your-public-bucket-domain.com

# --- Email ---
# Configure a real provider before enabling email in Railway.
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=__QUARK_PROJECT_NAME__ <noreply@yourdomain.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# ZEPTOMAIL_TOKEN=Zoho-enczapikey your_zeptomail_api_key
# ZEPTOMAIL_URL=https://api.zeptomail.com
# ZEPTOMAIL_BOUNCE_EMAIL=bounce@yourdomain.com

# --- Optional analytics ---
# NEXT_PUBLIC_UMAMI_URL=https://umami.example.com
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# NEXT_PUBLIC_UMAMI_REPLAY_ENABLED=false

# --- Optional tuning ---
# LOG_LEVEL=info
# CACHE_TTL=600
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000
# API_BODY_SIZE_LIMIT=2097152
# UPLOAD_SIZE_LIMIT=10485760
# ASSET_CDN_URL=https://cdn.yourdomain.com